include LICENSE README.md SECURITY.md pyproject.toml
include .gitignore .gitattributes
include requirements.txt
recursive-include docs *.md
recursive-include scripts *.py *.sh *.txt
recursive-include packaging *.py *.spec
recursive-include src/voicetype *.py
recursive-include tests *.py
recursive-include licenses *.txt *.md
recursive-include .github/workflows *.yml
exclude config.py voice_type.py run.sh probe_button.py
prune .venv
prune build
prune dist
prune .pytest_cache
prune .codebase-memory
global-exclude *.py[cod] .env .env.* *.pem *.key *.wav *.pcm
